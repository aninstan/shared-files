# Clipboard
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# Tabs / Windows
keybind = ctrl+t=new_tab
keybind = ctrl+n=new_window

# Close current tab
keybind = ctrl+shift+x=close_tab

# Splits
keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+up=new_split:up
keybind = ctrl+shift+down=new_split:down

# Reload Ghostty config
keybind = ctrl+shift+r=reload_config

# Source ~/.zshrc in the current shell
# (sends the text to the terminal, does not execute it)
keybind = ctrl+alt+r=text:source ~/.zshrc
